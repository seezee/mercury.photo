{
  "name": "mercury.photo",
  "version": "1.0.237",
  "description": "Rangefinder + Mirrorless Digital + Large Format Film Photography + Music, Arts, & News",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "11ty:watch": "npx @11ty/eleventy --watch --quiet --ignore-initial",
    "11ty:build": "npx @11ty/eleventy",
    "11ty:benchmark": "DEBUG=Eleventy:Benchmark* npm run build",
    "build": "ELEVENTY_ENV=production npx @11ty/eleventy",
    "util:rimraf": "npx rimraf _site",
    "util:killport": "npx kill-port --port 8787",
    "start": "ELEVENTY_ENV=dev npm-run-all util:rimraf util:killport 11ty:build --parallel 11ty:watch wrangler:dev",
    "wrangler:dev": "npx wrangler dev --live-reload",
    "wrangler:deploy": "npx wrangler deploy"
  },
  "keywords": [
    "photography",
    "music",
    "journalism"
  ],
  "homepage": "https://github.com/seezee/mercury.photo",
  "author": "Chris J. Zähller",
  "license": "Kelp Commons License",
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "eleventy-plugin-seo": "^0.5.2"
  },
  "devDependencies": {
    "@codestitchofficial/eleventy-plugin-minify": "^1.1.3",
    "@types/node": "^24.7.2",
    "@x-govuk/govuk-eleventy-plugin": "^8.0.4",
    "browserslist": "^4.26.3",
    "date-fns": "^4.1.0",
    "eleventy-auto-cache-buster": "^0.8.1",
    "esbuild": "^0.25.10",
    "esbuild-plugin-browserslist": "^1.0.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "npm-run-all": "^4.1.5",
    "outdent": "^0.8.0",
    "pagefind": "^1.4.0",
    "rimraf": "^6.0.1",
    "terser": "^5.44.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "Firefox ESR",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
