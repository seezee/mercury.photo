{
  "name": "mercury.photo",
  "version": "1.0.297",
  "description": "Rangefinder + Mirrorless Digital + Large Format Film Photography + Music, Arts, & News",
  "main": "index.js",
  "bugs": {
    "url": "https://github.com/seezee/mercury.photo/issues"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "11ty:watch": "npx @11ty/eleventy --watch --quiet --ignore-initial",
    "11ty:build": "npx @11ty/eleventy",
    "11ty:benchmark": "DEBUG=Eleventy:Benchmark* npm run build",
    "build": "ELEVENTY_ENV=production npx @11ty/eleventy",
    "util:rimraf": "npx rimraf _site",
    "start": "ELEVENTY_ENV=dev npm-run-all util:rimraf && npx @11ty/eleventy --serve --incremental",
    "start:prod": "ELEVENTY_ENV=production npm-run-all util:rimraf 11ty:build --parallel 11ty:watch wrangler:dev",
    "wrangler:dev": "npx wrangler dev --live-reload",
    "wrangler:deploy": "npx wrangler deploy"
  },
  "keywords": [
    "photography",
    "music",
    "journalism"
  ],
  "homepage": "https://github.com/seezee/mercury.photo",
  "author": "Chris J. Zähller",
  "license": "Kelp Commons License",
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "eleventy-plugin-seo": "^0.5.2"
  },
  "devDependencies": {
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@codestitchofficial/eleventy-plugin-minify": "github:CodeStitchOfficial/eleventy-plugin-minify",
    "@types/node": "^24.10.1",
    "browserslist": "^4.28.0",
    "eleventy-auto-cache-buster": "^0.8.3",
    "esbuild": "^0.27.0",
    "esbuild-plugin-browserslist": "^2.0.0",
    "html-minifier-terser": "^7.2.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "outdent": "^0.8.0",
    "pagefind": "^1.4.0",
    "rimraf": "^6.1.2",
    "terser": "^5.44.1",
    "wrangler": "^4.51.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "Firefox ESR",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 edge version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
