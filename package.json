{
  "name": "mercury.photo",
  "version": "1.0.371",
  "description": "Rangefinder + Mirrorless Digital + Large Format Film Photography + Music, Arts, & News",
  "main": "index.js",
  "bugs": {
    "url": "https://github.com/seezee/mercury.photo/issues"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "11ty:watch": "npx @11ty/eleventy --watch --quiet --ignore-initial",
    "11ty:build": "npx @11ty/eleventy",
    "11ty:benchmark": "DEBUG=Eleventy:Benchmark* npm run build",
    "build": "ELEVENTY_ENV=production npx @11ty/eleventy",
    "format": "npx @biomejs/biome format --write",
    "lint": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --write",
    "util:rimraf": "npx rimraf _site",
    "util:killport": "npx kill-port --port 8787",
    "util:killdev": "npx kill-port --port 8080",
    "start": "ELEVENTY_ENV=dev npm-run-all util:rimraf util:killdev && npx @11ty/eleventy --serve --incremental",
    "start:prod": "ELEVENTY_ENV=production npm-run-all util:rimraf util:killport 11ty:build --parallel 11ty:watch wrangler:dev",
    "wrangler:dev": "npx wrangler dev --live-reload",
    "wrangler:deploy": "npx wrangler deploy",
    "knip": "knip"
  },
  "keywords": [
    "photography",
    "music",
    "journalism"
  ],
  "homepage": "https://github.com/seezee/mercury.photo",
  "author": "Chris J. Zähller",
  "license": "Kelp Commons License",
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "eleventy-plugin-seo": "^0.5.2"
  },
  "//": {
    "devDependenciesPlaceholder" :
      [
        "These dependencies are commented out",
        "See https://bobbyhadz.com/blog/add-comments-to-package-json",
        "\"@11ty/is-land\": \"^5.0.1\"",
        "\"@zachleat/snow-fall\": \"^1.0.3\""
      ]
  },
  "devDependencies": {
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@biomejs/biome": "2.3.11",
    "@types/node": "^25.0.10",
    "browserslist": "^4.28.1",
    "eleventy-auto-cache-buster": "^0.8.3",
    "esbuild": "^0.27.2",
    "esbuild-plugin-browserslist": "^2.0.0",
    "html-minifier-next": "^4.19.0",
    "kill-port": "2.0.1",
    "knip": "^5.82.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "outdent": "^0.8.0",
    "pagefind": "^1.4.0",
    "rimraf": "^6.1.2",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.60.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "Firefox ESR",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 edge version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
