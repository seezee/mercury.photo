---
layout: layout-blog.njk
---
<main id="main" data-pagefind-body>
  <stack-l>
    <article class="post" data-pagefind-body>
      <stack-l>
        {{ content | safe }}
        {% if pubdate %}
          <small id="pubdate">Published <time datetime="{{ pubdate | toISOString | safe }}">{{ pubdate | dateTimeUK | safe }}</time></small>
        {% else %}
          No publication date found
        {% endif %}
        {% include "_pagination.njk" %}
      </stack-l>
    </article>
  </stack-l>
</main>
