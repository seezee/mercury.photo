<form action="https://formspree.io/f/mzzrblya" id="okie-x-artist-survey" method="POST" aria-labelledby="#okie-x-artist-s-survey">
  <stack-l>
    <fieldset><legend>Who are you?</legend>
      <stack-l>
        <div>
          <label for="name">What is your name?<span>*</span></label>
          <input
            id="name"
            type="text"
            name="name"
            maxLength="256"
            autocorrect="off"
            spellcheck="false"
            required
          />
        </div>
        <div>
          <label for="email">What is your email address?<span>*</span></label>
          <input
            id="email"
            type="email"
            name="email"
            maxLength="256"
            autocapitalize="none"
            autocorrect="off"
            spellcheck="false"
            required
          />
        </div>
        <div>
          <label for="phone">What is your mobile phone number?<span>*</span></label>
          <input
            id="phone"
            type="tel"
            name="phone"
            maxLength="16"
            autocapitalize="none"
            autocorrect="off"
            spellcheck="false"
            required
          />
        </div>
      </stack-l>
    </fieldset>
    <fieldset><legend>Tell us a little about your musical self</legend>
      <stack-l>
        <div>
          <label for="artist-name">If you are a solo performer who doesn’t perform under your birth name, what is your artist name?</label>
          <input
            id="artist-name"
            type="text"
            name="artist-name"
            maxLength="256"
          />
        </div>
        <fieldset><legend>Are you currently in a band?</legend>
          <label for="band-yes" class="form-control">
            <input
              id="band-yes"
              type="radio"
              name="in-band"
              value="Yes"
            />
            Yes
            </label>
          <label for="band-no" class="form-control">
            <input
              id="band-no"
              type="radio"
              name="in-band"
              value="No"
            />
            No
          </label>
        </fieldset>
        <stack-l>
          <label for="band-names">If you answered “Yes,” what is your band name (separate multiple items with commas)?</label>
          <textarea
            id="band-names"
            name="band-names"
            maxLength="4096"
          >
          </textarea>
        </stack-l>
        <stack-l>
          <label for="former-bands">List any bands you have played with in the past (i.e., been a member of) (separate multiple items with commas)</label>
          <textarea
            id="former-bands"
            name="former-bands"
            maxLength="4096"
          >
          </textarea>
        </stack-l>
        <stack-l>
          <label for="genres">What musical genre(s) do you perform (separate multiple items with commas)?</label>
          <textarea
            id="genres"
            name="genres"
            maxLength="4096"
          >
          </textarea>
        </stack-l>
        <stack-l>
          <label for="instruments">What instrument(s) do you play (separate multiple items with commas)?</label>
          <textarea
            id="instruments"
            name="instruments"
            maxLength="4096"
          >
          </textarea>
        </stack-l>
        <fieldset><legend>I am a (check all that apply):</legend>
          <label for="singer" class="form-control">
            <input
              id="singer"
              type="checkbox"
              name="skills"
              value="Singer"
            />
            Singer
          </label>
          <label for="rapper" class="form-control">
            <input
              id="rapper"
              type="checkbox"
              name="skills"
              value="Rapper"
            />
            Rapper
          </label>
          <label for="songwriter" class="form-control">
            <input
              id="songwriter"
              type="checkbox"
              name="skills"
              value="Songwriter"
            />
            Songwriter
          </label>
          <label for="composer" class="form-control">
            <input
              id="composer"
              type="checkbox"
              name="skills"
              value="Composer"
            />
            Composer
          </label>
          <label for="dj" class="form-control">
            <input
              id="dj"
              type="checkbox"
              name="skills"
              value="DJ"
            />
            DJ
          </label>
          <label for="producer" class="form-control">
            <input
              id="producer"
              type="checkbox"
              name="skills"
              value="Producer"
            />
            Producer
          </label>
        </fieldset>
      </stack-l>
    </fieldset>
    <fieldset><legend>What's your Oklahoma connection?</legend>
      <stack-l>
        <fieldset><legend>Do you currently live in Oklahoma?</legend>
          <label for="okie-yes" class="form-control">
            <input
              id="okie-yes"
              type="radio"
              name="okie"
              value="Yes"
            />
            Yes
          </label>
          <label for="okie-no" class="form-control">
            <input
              id="okie-no"
              type="radio"
              name="okie"
              value="No"
            />
            No
          </label>
        </fieldset>
        <stack-l>
          <label for="hometown">If you answered “Yes,” enter your current town. If you answered “No,” enter your former Oklahoma hometown</label>
          <input
            type="text"
            id="hometown"
            name="hometown"
            maxLength="256"
          >
        </stack-l>
        <stack-l>
          <label for="current-home">If you answered “No,” enter your current town and state</label>
          <input
            type="text"
            id="current-home"
            name="current-home"
            maxLength="256"
          >
        </stack-l>
      </stack-l>
    </fieldset>
    <fieldset><legend>Okay, let's finish this!</legend>
      <stack-l>
        <div class="sr-only">
          <label for="udedhllduoox">Skip this field if you’re human</label>
          <input
            id="udedhllduoox"
            type="text"
            name="gotcha"
            maxLength="64"
          />
        </div>
        <div>
          <label for="message">Type any additional comments or information here.</label>
          <textarea
            id="message"
            name="message"
            maxLength="4096"
            rows="10">
          </textarea>
        </div>

Maximum 4096 characters. Total Characters remaining: <span class="counter">4096</span>
      </stack-l>
    </fieldset>
    <stack-l>

<span class="required">*</span>By submitting this survey, I accept Mercury Photo Bureau’s [Privacy Policy](/legal/privacy/) and [Terms of Use](/legal/terms-of-use/), and I agree that the information I provide may be publicly displayed.
      <div>
        <label for="acceptance" class="form-control"><input
            id="acceptance"
            type="checkbox"
            name="acceptance"
            value="I accept"
            required
          />I accept</label>
      </div>
    </stack-l>
    <button
      class="g-recaptcha button button-primary"
      data-sitekey="6Lekt4AUAAAAAPOg3FNiArnM5ky35MGBAxJujirj"
      data-callback="onSubmit"
      data-action="submit">Send it!</button>
  </stack-l>
</form>

<script>
  const textarea = document.getElementById(`message`);
  const counter = document.querySelector(`.counter`);

  textarea.addEventListener(`keyup`, countCharacters, false);


  function countCharacters() {
      const text          = textarea.value;
      const textLength    = text.length;
      const textMax       = 4096;
      const textRemaining = (textMax - textLength);
      counter.innerText   = `${textRemaining}`;
  }
</script>
