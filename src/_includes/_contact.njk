<form action="https://formspree.io/f/xblojvwr" id="contact-form" method="POST" aria-labelledby="#talk-to-me">
  <stack-l>
    <div>
      <div class="cf-turnstile" data-sitekey="0x4AAAAAACNtFDIpDzvzMXIR" data-callback="enableSubmit"></div>
      <label for="name">Name<span>*</span></label>
      <input
        type="text"
        id="name"
        name="name"
        maxLength="256"
        autocorrect="off"
        spellcheck="false"
        autocomplete="name"
        required
      />
    </div>
    <div>
      <label for="email">Email<span>*</span></label>
      <input
        type="email"
        id="email"
        name="email"
        maxLength="256"
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        autocomplete="email"
        required
      />
    </div>
    <div>
      <label for="subject">Subject<span>*</span></label>
      <input
        id="subject"
        type="text"
        name="subject"
        maxLength="256"
        required
      />
    </div>
    <div class="sr-only">
      <label for="uiarkecdk">Skip this field if you’re human<span>*</span></label>
      <input
        id="uiarkecdk"
        type="text"
        name="_gotcha"
        maxLength="64"
      />
    </div>
    <div>
      <label for="message">Message<span>*</span></label>
      <textarea
        id="message"
        name="message"
        rows="10"
        required></textarea>
    </div>

Maximum <span id="msg-max">$</span> characters. Total Characters remaining: <span id="msg-counter">$</span>

    <button
      id="btnSubmit"
      class="button button-primary"
      name="btnSubmit">Send it!</button>
  </stack-l>
</form>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script src="/assets/js/message-counter.js"></script>
