<form action="https://formspree.io/f/xblojvwr" id="contact-form" method="POST" aria-labelledby="#talk-to-me">
  <stack-l>
    <div>
      <div
        class="cf-turnstile"
        data-sitekey="0x4AAAAAACNtFDIpDzvzMXIR"
        data-callback="enableSubmit"
      ></div>
      <label for="name">Name<span>*</span></label>
      <input
        id="name"
        type="text"
        name="name"
        maxLength="256"
        autocorrect="off"
        spellcheck="false"
        required
      />
    </div>
    <div>
      <label for="email">Email<span>*</span></label>
      <input
        id="email"
        type="email"
        name="email"
        maxLength="256"
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        required
      />
    </div>
    <div>
      <label for="subject">Subject<span>*</span></label>
      <input
        id="subject"
        type="text"
        name="subject"
        maxLength="256"
        required
      />
    </div>
    <div class="sr-only">
      <label for="uiarkecdk">Skip this field if you’re human<span>*</span></label>
      <input
        id="uiarkecdk"
        type="text"
        name="gotcha"
        maxLength="64"
      />
    </div>
    <div>
      <label for="message">Message<span>*</span></label>
      <textarea
        id="message"
        name="message"
        maxLength="4096"
        rows="10"
        required></textarea>
    </div>

Maximum 4096 characters. Total Characters remaining: <span class="counter">4096</span>

    <button
      id="btnSubmit"
      class="button button-primary"
      name="btnSubmit">Send it!</button>
  </stack-l>
</form>
<script src="<https://challenges.cloudflare.com/turnstile/v0/api.js>" async defer></script>
<script>
  const textarea = document.getElementById(`message`);
  const counter = document.querySelector(`.counter`);

  textarea.addEventListener(`keyup`, countCharacters, false);


  function countCharacters() {
      const text          = textarea.value;
      const textLength    = text.length;
      const textMax       = 4096;
      const textRemaining = (textMax - textLength);
      counter.innerText   = `${textRemaining}`;
  }
</script>
