  <script type="module">
    if (!(`anchorName` in document.documentElement.style)) {
      import(`https://unpkg.com/@oddbird/css-anchor-positioning`);
    }
  </script>
  <link rel="stylesheet" href="/assets/css/index.css">
  <meta property="og:site_name" content="{{ env.siteName }}">
  <meta property="article:publisher" content="https://facebook.com/mercuryphoto/">
  {% seo "" %}
  <!-- Facebook -->
  {% if image %}
    <meta property="og:image" content="{{ env.siteURL }}{{ image }}" />
  {% else %}
    <meta property="og:image" content="{{ env.siteURL }}/assets/images/site/mpb-logo.webp" />
  {% endif %}
  <meta property="fb:app_id" content="1811156772801459">
  <!-- Structured data -->
  {% if recipe %}
    {{ recipe | safe }}
  {% elif review %}
    {{ review | safe }}
  {% elif faq %}
    {{ faq | safe }}
  {% endif %}
  {% if '/blog/' in page.url %}
    {% if not '/tags/' in page.url %}
      {% if not index  %}
<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Article",
    "author": {
      "@type": "Person",
      "name": "{{ env.siteAuthor }}"
    },
    "publisher": {
      "@type": "Organization",
      "name": "{{ env.siteName }}",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ env.siteURL }}/assets/images/site/mpb-logo.webp"
      }
    },
        {% if title %}
    "headline": "{{ title }}",
        {% endif %}
        {% if image %}
    "image": "{{ env.siteURL }}{{ image }}",
        {% else %}
    "image": "{{ env.siteURL }}/assets/images/site/mpb-logo.webp",
        {% endif %}
        {% if pubdate %}
    "datePublished": "{{ pubdate | toISOString | safe }}",
        {% else %}
    "datePublished": "{{ page.date | toISOString | safe }}",
        {% endif %}
    "dateModified": "{{ page.date | toISOString | safe }}"
  }
</script>
      {% endif %}
    {% endif %}
  {% endif %}
</head>
