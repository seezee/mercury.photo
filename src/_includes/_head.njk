<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content">
  <!-- Grab title from the page data and dump it here -->
  <link rel="icon" href="/favicon.ico" sizes="48x48"><!-- `sizes="48x48"` tricks Chromium browsers into using the SVG. Safari 26 will support SVG; in the meantime it will use the .ico -->
  {% if env.env == 'production' %}
    <link rel="icon" href="/icon.svg" sizes="any" type="image/svg+xml">
  {% else %}
    <link rel="icon" href="/icon-dev.svg" sizes="any" type="image/svg+xml">
  {% endif %}
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"><!-- 180×180 -->
  <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials">
  <link rel="preload" href="/assets/fonts/Merriweather-Subset.woff2" as="font" crossorigin>
  <link rel="preload" href="/assets/fonts/MerriweatherSans-Subset.woff2" as="font" crossorigin>
  <link rel="preload" href="/assets/fonts/PlayfairDisplay-Subset.woff2" as="font" crossorigin>
  <link rel="preload" href="/assets/fonts/Cousine-Subset.woff2" as="font" crossorigin>
  <!-- Used with snow-fall; okay to comment out after holidays -->
  <script type="module" src="/assets/js/is-land.js"></script>
  <!-- Must load in head or masonry layout fails -->
  <script src="/assets/js/index.js" type="module"></script>
  <script type="speculationrules">
    {
      "prerender": [
        {
          "where": {
            "and": [
              { "href_matches": "/*" },
              { "not": { "selector_matches": "[rel~=nofollow]" } },
              { "not": { "selector_matches": "[rel~=external]" } }
            ]
          },
          "eagerness": "moderate"
        }
      ],
      "prefetch": [
        {
          "where": {
            "and": [
              { "href_matches": "/*" },
              { "not": { "selector_matches": "[rel~=nofollow]" } },
              { "not": { "selector_matches": "[rel~=external]" } }
            ]
          },
          "eagerness": "eager"
        }
      ]
    }
  </script>
  <style>
    :root {
      --mpb-details-marker: url(/assets/images/icons/chevron-right.svg);
      --mpb-icon-external: url(/assets/images/icons/external.svg);
      --mpb-icon-link: url(/assets/images/icons/link.svg);
      --mpb-icon-search: url(/assets/images/icons/search.svg);
      --mpb-icon-stickynote: url(/assets/images/icons/sticky-note.svg);
    }

    html[data-theme='dark'] {
      --mpb-details-marker: url(/assets/images/icons/chevron-right-dark.svg);
      --mpb-icon-external: url(/assets/images/icons/external-dark.svg);
      --mpb-icon-link: url(/assets/images/icons/link-dark.svg);
      --mpb-icon-search: url(/assets/images/icons/search-dark.svg);
      --mpb-icon-stickynote: url(/assets/images/icons/sticky-note-dark.svg);
    }

    @font-face {
      font-family: Merriweather-Subset;
      src: url('/assets/fonts/Merriweather-Subset.woff2') format('woff2');
      font-display: eager;
      font-weight: 400;
      font-style: normal;
      unicode-range: U+30-U+39,U+41-U+5A, U+61-U+7A;
    }

    @font-face {
      font-family: MerriweatherSans-Subset;
      url:('/assets/fonts/MerriweatherSans-Subset.woff2') format('woff2');
      font-display: eager;
      font-weight: 400;
      font-style: normal;
      unicode-range: U+30-U+39,U+41-U+5A, U+61-U+7A;
    }

    @font-face {
      font-family: PlayfairDisplay-Subset;
      src: url('/assets/fonts/PlayfairDisplay-Subset.woff2') format('woff2');
      font-display: eager;
      font-weight: 700;
      font-style: normal;
      unicode-range: U+30-U+39,U+41-U+5A, U+61-U+7A;
    }

    @font-face {
      font-family: Cousine-Subset;
      src: url('/assets/fonts/Cousine-Subset.woff2') format('woff2');
      font-display: eager;
      font-weight: 400;
      font-style: normal;
      unicode-range: U+30-U+39,U+41-U+5A, U+61-U+7A;
    }

    @font-face {
      font-family: Merriweather;
      src: url('/assets/fonts/Merriweather-Variable.woff2') format('woff2-variations');
      font-display: swap;
      font-weight: 100 1000;
      font-width: 25 250;
      font-style: normal;
    }

    @font-face {
      font-family: Merriweather;
      src: url('/assets/fonts/Merriweather-Italic-Variable.woff2') format('woff2-variations');
      font-display: swap;
      font-weight: 100 1000;
      font-width: 25 250;
      font-style: italic;
    }

    @font-face {
      font-family: MerriweatherSans;
      src: url('/assets/fonts/MerriweatherSans-Variable.woff2') format('woff2-variations');
      font-display: swap;
      font-weight: 100 1000;
      font-style: normal;
    }

    @font-face {
      font-family: MerriweatherSans;
      src: url('/assets/fonts/MerriweatherSans-Italic-Variable.woff2') format('woff2-variations');
      font-display: swap;
      font-weight: 100 1000;
      font-style: italic;
    }

    @font-face {
      font-family: Playfair;
      src: url('/assets/fonts/PlayfairDisplay-Variable.woff2') format('woff2-variations');
      font-display: swap;
      font-style: normal;
      font-weight: 100 1000;
      font-variant: normal;
    }

    @font-face {
      font-family: Playfair;
      src: url('/assets/fonts/PlayfairDisplay-Italic-Variable.woff2') format('woff2-variations');
      font-display: swap;
      font-style: italic;
      font-weight: 100 1000;
      font-variant: normal;
    }

    @font-face {
      font-family: PlayfairSC;
      src: url('/assets/fonts/PlayfairDisplaySC-Regular.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--normal, 400); /* Doesn't support 500 */
      font-style: normal;
      font-variant: small-caps;
    }

    @font-face {
      font-family: PlayfairSC;
      src: url('/assets/fonts/PlayfairDisplaySC-Italic.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--normal, 500);
      font-style: italic;
      font-variant: small-caps;
    }

    @font-face {
      font-family: PlayfairSC;
      src: url('/assets/fonts/PlayfairDisplaySC-Bold.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--bold, 700);
      font-style: normal;
      font-variant: small-caps;
    }

    @font-face {
      font-family: PlayfairSC;
      src: url('/assets/fonts/PlayfairDisplaySC-BoldItalic.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--bold, 700);
      font-style: italic;
      font-variant: small-caps;
    }

    @font-face {
      font-family: Cousine;
      src: url('/assets/fonts/Cousine-Regular.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--normal, 500);
      font-style: normal;
    }

    @font-face {
      font-family: Cousine;
      src: url('/assets/fonts/Cousine-Italic.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--normal, 500);
      font-style: italic;
    }

    @font-face {
      font-family: Cousine;
      src: url('/assets/fonts/Cousine-Bold.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--bold, 700);
      font-style: normal;
    }

    @font-face {
      font-family: Cousine;
      src: url('/assets/fonts/Cousine-BoldItalic.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--bold, 700);
      font-style: italic;
    }

    html {
      font-family: serif;
    }

    .fonts-stage-1 {
      font-family: Merriweather-Subset, serif;

      .blog-index li p {
        font-family: Merriweather-Subset, serif;
      }

      h1,
      h2,
      h3,
      legend,
      .drop-cap:first-letter,
      h1 ~ p:not(:empty):first-of-type::first-letter,
      hgroup:has(stack-l h1) ~ p:not(:empty):first-of-type::first-letter {
        font-family: PlayfairDisplay-Subset, serif;
      }

      .wedding-services-wrapper h2,
      .spkr {
        font-family: PlayfairDisplay-Subset, serif;
        font-variant: small-caps;
      }

      dt,
      summary,
      button,
      button a,
      .button a,
      .button,
      label,
      nav,
      .blog-index,
      .tags-button
      .header-pricelist .wedding-services-wrapper li,
      .admonition-heading,
      .widget__btn {
        font-family: MerriweatherSans-Subset, sans-serif;
      }

      table,
      input,
      textarea,
      select,
      kbd,
      code,
      math,
      .pagefind-ui__search-input,
      .blog-index {
        font-family: Cousine-Subset, monospace;
      }
    }
  </style>
  <script>
