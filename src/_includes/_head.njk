<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content">
  <!-- Grab title from the page data and dump it here -->
  <link rel="icon" href="/favicon.ico" sizes="48x48"><!-- `sizes="48x48"` tricks Chromium browsers into using the SVG. Safari 26 will support SVG; in the meantime it will use the .ico -->
  {% if production %}
    <link rel="icon" href="/icon.svg" sizes="any" type="image/svg+xml" foo="bar">
  {% else %}
    <link rel="icon" href="/icon-dev.svg" sizes="any" type="image/svg+xml">
  {% endif %}
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"><!-- 180×180 -->
  <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials">
  <link rel="preload" href="/assets/fonts/Merriweather-Variable.woff2" as="font" crossorigin>
  <link rel="preload" href="/assets/fonts/MerriweatherSans-Variable.woff2" as="font" crossorigin>
  <link rel="preload" href="/assets/fonts/PlayfairDisplay-Variable.woff2" as="font" crossorigin>
  <!-- Must load in head or masonry layout fails -->
  <script src="/assets/js/index.js" type="module"></script>
  <script type="speculationrules">
    {
      "prerender": [
        {
          "where": {
            "href_matches": "/*"
          },
          "eagerness": "eager"
        }
      ]
    }
  </script>
  <script type="module">
    if (!(`anchorName` in document.documentElement.style)) {
      import(`https://unpkg.com/@oddbird/css-anchor-positioning`);
    }
  </script>
  <style>
    :root {
      --mpb-details-marker: url(/assets/images/icons/chevron-right.svg);
      --mpb-icon-external: url(/assets/images/icons/external.svg);
      --mpb-icon-search: url(/assets/images/icons/search.svg);
      --mpb-icon-stickynote: url(/assets/images/icons/sticky-note.svg);
    }

    [data-theme='dark'] {
      --mpb-details-marker: url(/assets/images/icons/chevron-right-dark.svg);
      --mpb-icon-external: url(/assets/images/icons/external-dark.svg);
      --mpb-icon-search: url(/assets/images/icons/search-dark.svg);
      --mpb-icon-stickynote: url(/assets/images/icons/sticky-note-dark.svg);
    }

    @font-face{
      font-family: Merriweather;
      src: url('/assets/fonts/Merriweather-Variable.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--normal, 500);
      font-style: normal;
    }

    @font-face{
      font-family: Merriweather;
      src: url('/assets/fonts/Merriweather-Italic-Variable.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--normal, 500);
      font-style: italic;
    }

    @font-face{
      font-family: MerriweatherSans;
      src: url('/assets/fonts/MerriweatherSans-Variable.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--normal, 500);
      font-style: normal;
    }

    @font-face{
      font-family: MerriweatherSans;
      src: url('/assets/fonts/MerriweatherSans-Italic-Variable.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--normal, 500);
      font-style: italic;
    }

    @font-face{
      font-family: Playfair;
      src: url('/assets/fonts/PlayfairDisplay-Variable.woff2') format('woff2');
      font-display: swap;
      font-style: normal;
      font-weight: var(--normal, 500);
      font-variant: normal;
    }

    @font-face{
      font-family: Playfair;
      src: url('/assets/fonts/PlayfairDisplay-Italic-Variable.woff2') format('woff2');
      font-display: swap;
      font-style: italic;
      font-weight: var(--normal, 500);
      font-variant: normal;
    }

    @font-face{
      font-family: PlayfairSC;
      src: url('/assets/fonts/PlayfairDisplaySC-Regular.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--normal, 500);
      font-style: normal;
      font-variant: small-caps;
    }

    @font-face{
      font-family: PlayfairSC;
      src: url('/assets/fonts/PlayfairDisplaySC-Italic.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--normal, 500);
      font-style: italic;
      font-variant: small-caps;
    }

    @font-face{
      font-family: PlayfairSC;
      src: url('/assets/fonts/PlayfairDisplaySC-Bold.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--bold, 700);
      font-style: normal;
      font-variant: small-caps;
    }

    @font-face{
      font-family: PlayfairSC;
      src: url('/assets/fonts/PlayfairDisplaySC-BoldItalic.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--bold, 700);
      font-style: italic;
      font-variant: small-caps;
    }

    @font-face{
      font-family: Cousine;
      src: url('/assets/fonts/Cousine-Regular.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--normal, 500);
      font-style: normal;
    }

    @font-face{
      font-family: Cousine;
      src: url('/assets/fonts/Cousine-Italic.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--normal, 500);
      font-style: italic;
    }

    @font-face{
      font-family: Cousine;
      src: url('/assets/fonts/Cousine-Bold.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--bold, 700);
      font-style: normal;
    }

    @font-face{
      font-family: Cousine;
      src: url('/assets/fonts/Cousine-BoldItalic.woff2') format('woff2');
      font-display: swap;
      font-weight: var(--bold, 700);
      font-style: italic;
    }
  </style>
  <link rel="stylesheet" href="/assets/css/index.css">
  <meta property="og:site_name" content="{{ _SITENAME_ }}">
  <meta property="article:publisher" content="https://facebook.com/mercuryphoto/">
  {% seo "" %}
  <!-- Facebook -->
  {% if image %}
    <meta property="og:image" content="{{ _SITEURL_ }}{{ image }}" />
  {% else %}
    <meta property="og:image" content="{{ _SITEURL_ }}/assets/images/site/mpb-logo.webp" />
  {% endif %}
  <meta property="fb:app_id" content="1811156772801459">
  <!-- Structured data -->
  {% if recipe %}
    {{ recipe | safe }}
  {% elif review %}
    {{ review | safe }}
  {% endif %}
  {%- if '/blog' in page.url -%}
    {% if not index %}
      <script type="application/ld+json">
        {
          "@context": "http://schema.org/",
          "@type": "Article",
          "author": {
            "@type": "Person",
            "name": "{{ _AUTHOR_ }}"
          },
          "publisher": {
            "@type": "Organization",
            "name": "{{ title }}",
            "logo": {
              "@type": "ImageObject",
              "url": "{{ _SITEURL_ }}/assets/images/site/mpb-logo.webp"
            }
          },
        {% if title %}
          "headline": "{{ title }}",
        {% endif %}
        {% if image %}
          "image": "{{ _SITEURL_ }}/{{ image }}",
        {% else %}
          "image": "{{ _SITEURL_ }}/assets/images/site/mpb-logo.webp",
        {% endif %}
        {% if pubdate %}
          "datePublished": "{{ pubdate | toISOString | safe }}",
        {% else %}
          "datePublished": "{{ page.date | toISOString | safe }}",
        {% endif %}
          "dateModified": "{{ page.date | toISOString | safe }}"
        }
      </script>
    {% endif %}
  {%- endif -%}
</head>
